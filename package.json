{
  "name": "floornet",
  "version": "0.0.1",
  "description": "A wordnet database in parquet",
  "license": "MIT",
  "repository": "github:spencermountain/floornet",
  "author": "Spencer Kelly <spencermountain@gmail.com> (https://spencermountain.dev)",
  "type": "module",
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rollup --config",
    "build:data": "node scripts/build-parquet.js",
    "watch": "node --watch scratch.js",
    "test": "node --test --test-reporter=tap \"tests/**/*.test.js\" | tap-dancer",
    "test:tap": "node --test --test-reporter=tap \"tests/**/*.test.js\"",
    "lint": "eslint ."
  },
  "dependencies": {
    "hyparquet": "1.31.1",
    "hyparquet-compressors": "1.1.2"
  },
  "devDependencies": {
    "@duckdb/node-api": "1.5.5-r.5",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "eslint": "10.11.0",
    "rollup": "4.63.5",
    "rollup-plugin-filesize-check": "2.0.1",
    "tap-dancer": "0.4.3"
  }
}
