{
  "name": "floornet",
  "version": "0.0.1",
  "description": "A wordnet database in parquet",
  "license": "MIT",
  "repository": "github:spencermountain/floornet",
  "author": "Spencer Kelly <spencermountain@gmail.com> (https://spencermountain.dev)",
  "type": "module",
  "main": "./builds/floornet.cjs",
  "types": "./types/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rollup --config",
    "build:data": "node scripts/build-parquet.js",
    "watch": "node --watch scratch.js",
    "test": "node --test --test-reporter=tap \"tests/**/*.test.js\" | tap-dancer",
    "test:tap": "node --test --test-reporter=tap \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "prepack": "pnpm build:data && pnpm build"
  },
  "dependencies": {
    "hyparquet": "1.31.1",
    "hyparquet-compressors": "1.1.2"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "eslint": "10.11.0",
    "hyparquet-writer": "0.16.10",
    "rollup": "4.64.0",
    "rollup-plugin-filesize-check": "2.0.1",
    "tap-dancer": "0.4.4"
  },
  "module": "./builds/floornet.browser.mjs",
  "browser": "./builds/floornet.browser.mjs",
  "exports": {
    ".": {
      "browser": {
        "types": "./types/browser.d.ts",
        "default": "./builds/floornet.browser.mjs"
      },
      "node": {
        "types": "./types/index.d.ts",
        "import": "./builds/floornet.mjs",
        "require": "./builds/floornet.cjs"
      },
      "types": "./types/browser.d.ts",
      "default": "./builds/floornet.browser.mjs"
    },
    "./browser": {
      "types": "./types/browser.d.ts",
      "default": "./builds/floornet.browser.mjs"
    },
    "./builds/*": "./builds/*",
    "./data/wordnet.parquet": "./data/wordnet.parquet"
  },
  "files": [
    "builds/",
    "types/",
    "data/wordnet.parquet"
  ]
}
